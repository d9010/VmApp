{
  "format": 1,
  "id": "dev.vmapp.hostcaps",
  "name": "HostCaps",
  "version": "1.0.0",
  "publisher": "D9010 VmApp tests",
  "description": "Uses host capabilities through the SDK (tests/unit/hostcaps-realvm.test.js).",
  "runtime": "node22",
  "core": { "command": ["node", "main.js"] },
  "ui": { "root": "ui" },
  "permissions": {
    "dialogs": false,
    "host": [
      { "cap": "screen", "purpose": "Reads the screen" },
      { "cap": "input", "purpose": "Clicks and types" },
      { "cap": "tool:echo", "purpose": "Runs echo" }
    ]
  }
}
