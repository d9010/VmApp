#
# Spike overlay for the vmapp guest kernel (gpu/venus-spike): what the pinned kernel/ config lacks to run on
# libkrun (Hypervisor.framework, virtio over MMIO) with a virtio-gpu / Venus device and an ext4 root disk.
# Appended AFTER kernel/vmapp-guest.config by kernel/build.sh of this folder, so these lines win.
#
# Nothing here is a product decision. A real "gpu" capability would add a GPU-specific kernel flavour (or enable
# these in the shared kernel) after a security review: DRM is a large attack surface (the base config forbids it).
#

# libkrun describes its devices in the device tree as virtio-mmio nodes (Virtualization.framework uses PCI).
CONFIG_VIRTIO_MMIO=y
# CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES is not set

# The spike root filesystem is an ext4 disk image (the product uses EROFS runtime image + cpio).
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y

# Power off from PID 1 with `echo o > /proc/sysrq-trigger`.
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0x1

# virtio-gpu: DRM driver with 3D (virgl/venus) contexts, host-visible blobs, no framebuffer console.
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VIRTIO_GPU_KMS=y
CONFIG_SYNC_FILE=y
