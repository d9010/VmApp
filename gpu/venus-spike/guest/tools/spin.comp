#version 450
// Burns GPU time: each invocation runs `iters` dependent FMAs (a long-running kernel to probe the GPU watchdog).
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Out { float data[]; };
layout(push_constant) uniform PC { uint iters; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    float a = float(i) * 1e-6 + 1.0;
    float b = 0.999999;
    for (uint k = 0u; k < pc.iters; k++) {
        a = fma(a, b, 1e-7);
        b = fma(b, 0.9999999, 1e-9);
    }
    data[i] = a + b;
}
