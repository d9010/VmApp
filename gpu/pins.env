# vmapp GPU capability, phase B (SPEC 8.6): pinned llama.cpp build inputs (single source of truth).
#
# Both ends of the llama.cpp RPC remoting MUST be built from this same commit:
#   - the HOST rpc-server (Metal), built by gpu/build.sh and shipped inside the loader;
#   - the VM-side llama.cpp client that connects to $VMAPP_GPU_RPC (an app's own build: apps/local-llm).
# The RPC protocol is versioned (ggml-rpc.h) and the server refuses a client whose major version differs, so an app that
# builds llama.cpp from another commit may not be able to talk to the host's server. Check RPC_PROTO_VERSION.
#
# Plain KEY=VALUE lines only (no shell expansion, no command substitution): gpu/build.sh parses this file strictly and
# refuses anything else. Apps and tools may read it the same way.

# The upstream repository and the release tag. A tag is just a name: the commit below is what is trusted.
LLAMA_CPP_REPO=https://github.com/ggml-org/llama.cpp.git
LLAMA_CPP_TAG=b11299
# The exact commit the tag points to (git rev-parse HEAD after the clone). gpu/build.sh refuses a checkout that differs.
LLAMA_CPP_COMMIT=b04642061d183dff8504127dfbee1c1a8352682c
# Release date of the tag (UTC). Pins are chosen at least 14 days old, so a bad release has been noticed by others first.
LLAMA_CPP_TAG_DATE=2026-09-30

# RPC_PROTO_{MAJOR,MINOR,PATCH}_VERSION of ggml/include/ggml-rpc.h at that commit. gpu/build.sh checks it against the source,
# so a bump of LLAMA_CPP_COMMIT without a look at the protocol fails the build.
RPC_PROTO_VERSION=7.0.0

# The CMake target of the server in that tree (it was called rpc-server before upstream renamed it), and the name it is
# installed under in out/gpu/.
RPC_SERVER_TARGET=ggml-rpc-server
RPC_SERVER_NAME=rpc-server

# Oldest macOS the server is built for.
MACOS_DEPLOYMENT_TARGET=13.0
