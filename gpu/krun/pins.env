# vmapp EXPERIMENTAL Vulkan GPU backend (libkrun + virglrenderer/Venus + MoltenVK): pinned build inputs
# (single source of truth for gpu/krun/build-libs.sh).
#
# Plain KEY=VALUE lines only (no shell expansion, no command substitution): build-libs.sh parses this file strictly
# and refuses anything else. Read it, never `source` it. A tag is just a name: the *_COMMIT below is what is trusted,
# and build-libs.sh refuses a checkout whose HEAD is a different commit.
#
# Provenance of the pins: gpu/venus-spike/BUILD.md (the research spike that proved this stack). To update one, see
# gpu/krun/README.md ("Updating a pin").

# --- Host libraries (cloned with `git clone --depth 1 --branch <tag>`) ----------------------------------------------

# MoltenVK: Vulkan on Metal (Apache-2.0). The host Vulkan implementation behind virglrenderer.
MOLTENVK_REPO=https://github.com/KhronosGroup/MoltenVK.git
MOLTENVK_TAG=v1.4.2
MOLTENVK_COMMIT=db66022459ffb663aa2b50f6b018bc2e124f5edf
MOLTENVK_LICENSE=Apache-2.0

# libepoxy: link dependency of virglrenderer, the GL path is unused (MIT).
EPOXY_REPO=https://github.com/anholt/libepoxy.git
EPOXY_TAG=1.5.10
EPOXY_COMMIT=c84bc9459357a40e46e2fec0408d04fbdde2c973
EPOXY_LICENSE=MIT

# virglrenderer, Sergio Lopez's macOS fork used by libkrun/krunkit: Venus renderer, in-process context, macOS blob
# sharing (11 commits on upstream 0.10.4). The patches in gpu/krun/patches/ are applied on this exact commit (MIT).
VIRGL_REPO=https://gitlab.freedesktop.org/slp/virglrenderer.git
VIRGL_TAG=0.10.4e-krunkit
VIRGL_COMMIT=bfec2d27c3953ee0530c459c2f5d042c2b619fa1
VIRGL_LICENSE=MIT

# libkrun: the VMM library (Hypervisor.framework, virtio-gpu, vsock, virtiofs, block) (Apache-2.0).
KRUN_REPO=https://github.com/containers/libkrun.git
KRUN_TAG=v1.19.6
KRUN_COMMIT=227b2de6ed323fe180e02f871c5f325a90c13cc2
KRUN_LICENSE=Apache-2.0
# Cargo features, as `make` variables. BLK: virtio-blk disks. GPU: virtio-gpu (Venus). NET is deliberately NOT here:
# the net feature is libkrun's own virtio-net code (passt/gvproxy/tap back ends) and nothing in vmapp uses it, so it
# is not compiled in (there is then no way to attach a network device at all). The C API the launcher uses
# (krun_add_disk3, krun_add_virtiofs3, krun_add_vsock*, krun_set_gpu_options2, krun_set_kernel) does not need it.
KRUN_MAKE_FLAGS=BLK=1 GPU=1

# --- Build tools -----------------------------------------------------------------------------------------------------

# Rust toolchain: installed under $VMAPP_WORK/krun-rust by this rustup-init (download verified by its sha256).
# https://static.rust-lang.org/rustup/archive/1.29.1/aarch64-apple-darwin/rustup-init.sha256 says the same.
RUST_VERSION=1.99.1
RUSTUP_INIT_VERSION=1.29.1
RUSTUP_INIT_URL=https://static.rust-lang.org/rustup/archive/1.29.1/aarch64-apple-darwin/rustup-init
RUSTUP_INIT_SHA256=ec1b9233e7f72990ecd8e62063fa7f6c3dfc2bec8e97f88bff165f9100ac696a

# meson and ninja come from a pip venv in $VMAPP_WORK/krun-venv. The wheels are pinned BY HASH in gpu/krun/requirements.txt
# (installed with --require-hashes --only-binary=:all:); build-libs.sh checks that the versions there equal these.
MESON_VERSION=1.9.1
NINJA_VERSION=1.13.2

# --- libkrun's init program ------------------------------------------------------------------------------------------

# libkrun embeds a small static Linux init (src/init_blob), cross-compiled on the Mac with clang + rust-lld against a
# Debian bookworm sysroot. Its Makefile downloads the sysroot's 4 packages from deb.debian.org with no verification, so
# build-libs.sh builds the sysroot itself from these exact packages (snapshot.debian.org, sha256-verified; libc6 is
# the version the Makefile fetched in the Venus spike) and hands it
# to the Makefile (SYSROOT_LINUX). glibc is statically linked into that init program (LGPL-2.1+): see licenses/.
DEBIAN_SNAPSHOT_URL=https://snapshot.debian.org/archive/debian/20260801T000000Z
SYSROOT_GCC_VERSION=12
SYSROOT_LIBC6_PATH=pool/main/g/glibc/libc6_2.36-9+deb12u14_arm64.deb
SYSROOT_LIBC6_SHA256=01f4330719fd4f65580e16ea5a0527f372fca750e8f588d26deaf09f2d3b1cf4
SYSROOT_LIBC6_DEV_PATH=pool/main/g/glibc/libc6-dev_2.36-9+deb12u14_arm64.deb
SYSROOT_LIBC6_DEV_SHA256=8bc395bf2ee9939f1a6ae395f974cffdcf541d98f99adfe89ce7e4bef36d159e
SYSROOT_LIBGCC_DEV_PATH=pool/main/g/gcc-12/libgcc-12-dev_12.2.0-14+deb12u1_arm64.deb
SYSROOT_LIBGCC_DEV_SHA256=c83d28b7c3397c25f15ae17783fce78716a3d7cd415940940cc2af8dc4db8d6d
SYSROOT_LINUX_LIBC_DEV_PATH=pool/main/l/linux/linux-libc-dev_6.1.176-1_arm64.deb
SYSROOT_LINUX_LIBC_DEV_SHA256=eeca5ec13bed7206f8171fab9a48e84119dcc20cc79557f104628447a524ad10
# gcc-12-base only carries libgcc's copyright file (usr/share/doc/libgcc-12-dev is a symlink into it): shipped in licenses/.
SYSROOT_GCC_BASE_PATH=pool/main/g/gcc-12/gcc-12-base_12.2.0-14+deb12u1_arm64.deb
SYSROOT_GCC_BASE_SHA256=674cf6cba6d432bd200c45fe866c1652c7a53523cc2e7a613e05bc4abf7b5440

# --- Build settings --------------------------------------------------------------------------------------------------

# Oldest macOS the meson-built libraries (virglrenderer, libepoxy) and libkrun are built for. MoltenVK keeps the minimum
# of its own Xcode project. Only macOS 15 on Apple silicon has been tested (see README.md).
MACOS_DEPLOYMENT_TARGET=13.0
