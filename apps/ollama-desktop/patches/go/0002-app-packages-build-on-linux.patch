@@ -0,0 +1,9 @@
+package updater
+
+// There is no self-updater on Linux: whatever packages the app (here a vmapp package) updates it. updater.go builds without the
+// platform files; this is the one function app/ui calls that only they define.
+
+// IsUpdatePending reports whether a downloaded update is waiting to be installed. Never, on Linux.
+func IsUpdatePending() bool {
+	return false
+}
