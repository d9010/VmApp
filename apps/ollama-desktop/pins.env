# Ollama (Desktop): pinned build inputs (read by apps/ollama-desktop/build.sh).
#
# Plain KEY=VALUE lines only (no shell expansion, no command substitution, no spaces in values): build.sh parses this file strictly.
#
# What is built, all from the one Ollama tag below: `ollama` (the server and the CLI), `vmapp-ui` (the app's own Go backend, headless),
# the CPU runners (llama-server and the ggml CPU variants), and the app's React UI. The Vulkan backend (libggml-vulkan.so) comes from
# apps/ollama/vulkan (its own pins; the same Ollama tag).

# Ollama v0.35.0: the tag and the commit it must be. Same values as apps/ollama/pins.env (the Vulkan build checks the commit).
OLLAMA_VERSION=0.35.0
OLLAMA_TAG=v0.35.0
OLLAMA_TAG_COMMIT=cc4069396f3ad2c370c53eed2e4a42ac13adab84
OLLAMA_REPO=https://github.com/ollama/ollama.git
# Ollama's MIT licence at the tag (same value as apps/ollama/pins.env).
OLLAMA_LICENSE_SHA256=5934ed2ce0d15154bcdb9c85203210abac0da4314af34081e36df4599f90b226

# llama.cpp at the tag of Ollama's LLAMA_CPP_VERSION (b11081), by tag AND commit; the runner build fetches it with cmake's FetchContent
# and checks that the commit is this one. Same values as apps/ollama/vulkan/pins.env.
LLAMA_CPP_TAG=b11081
LLAMA_CPP_COMMIT=161755f29e415e2c33efe906e91843c068efd664

# The build container: golang:1.26.7-trixie by digest (also written in build/Dockerfile; build.sh checks both agree), the Debian
# snapshot that the image documents, and the exact packages installed on top of it.
GOLANG_IMAGE_DIGEST=sha256:978084e7adea0904b6d76cbc9afcb9baeed6ee170eecdc8866566aaa9f22ad0c
APT_SNAPSHOT=20260824T000000Z
APT_CMAKE=3.31.6-2
APT_NINJA_BUILD=1.12.1-1+b1

# The UI is built with the Node of runtime node22: its base image (read from runtimes/node22/Dockerfile by build.sh, not repeated here).
