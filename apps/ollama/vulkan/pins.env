# Ollama's Vulkan backend for linux-arm64: pinned build inputs (read by apps/ollama/vulkan/build-vulkan.sh).
#
# Plain KEY=VALUE lines only (no shell expansion, no command substitution, no spaces in values): the script parses this file strictly.
#
# What is built: libggml-vulkan.so, the one library the linux-arm64 release of Ollama does not ship (its backends are CPU and CUDA).
# Ollama 0.35.0 does not vendor llama.cpp: llama/server/CMakeLists.txt fetches the tag named in the file LLAMA_CPP_VERSION of the
# Ollama tag, applies llama/compat/001-llama-cpp-hooks.patch (call sites in src/llama-model-loader.cpp and tools/mtmd/clip.cpp only:
# no ggml file), and builds the preset `vulkan` of llama/server/CMakePresets.json (GGML_VULKAN=ON, GGML_BACKEND_DL=ON,
# BUILD_SHARED_LIBS=ON, GGML_NATIVE=OFF, GGML_OPENMP=OFF; the backend lands in lib/ollama/vulkan/ as libggml-vulkan.so). The
# Dockerfile re-checks all of that against Ollama's own files at OLLAMA_TAG_COMMIT, so a wrong pin fails the build instead of
# producing a library that does not fit the release.
#
# Why upstream llama.cpp unpatched is enough: the library is built from ggml/ only, and the compat patch does not touch ggml/.
# What must match the release is ggml's version (its libggml-base.so.<version>); the Dockerfile compares it with the release's file.

# Ollama's tag and its commit: equal to OLLAMA_TAG_COMMIT of ../pins.env (build-vulkan.sh checks).
OLLAMA_TAG_COMMIT=cc4069396f3ad2c370c53eed2e4a42ac13adab84

# llama.cpp at the tag in Ollama's LLAMA_CPP_VERSION (b11081), by tag AND full commit (git ls-remote refs/tags/b11081).
LLAMA_CPP_REPO=https://github.com/ggml-org/llama.cpp.git
LLAMA_CPP_TAG=b11081
LLAMA_CPP_COMMIT=161755f29e415e2c33efe906e91843c068efd664

# Build tools from the Debian trixie snapshot of runtimes/node22-gpu/Dockerfile (the Dockerfile here uses the same base image digest
# and snapshot date, so the library is built against exactly the glibc and libstdc++ of the runtime that will load it; build-vulkan.sh
# checks both against that file). Versions as listed in snapshot.debian.org/archive/debian/20261005T000000Z, trixie/main/arm64.
APT_BUILD_ESSENTIAL=12.12
APT_CMAKE=3.31.6-2
APT_NINJA_BUILD=1.12.1-1+b1
APT_GLSLC=2025.2-1
APT_LIBVULKAN_DEV=1.4.309.0-1
APT_SPIRV_HEADERS=1.6.1+1.4.309.0-1
