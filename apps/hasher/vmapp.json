{
  "format": 1,
  "id": "dev.vmapp.hasher",
  "name": "Hasher",
  "version": "1.0.0",
  "publisher": "D9010 VmApp samples",
  "description": "Computes SHA-256 hashes of every file in a folder you pick, with a core written in Rust.",
  "runtime": "native",
  "core": {
    "command": ["/app/hasher"],
    "workdir": "/app",
    "memoryMiB": 128,
    "cpus": 1
  },
  "ui": { "root": "ui" },
  "permissions": {
    "folders": [],
    "dialogs": true,
    "external": false
  }
}
