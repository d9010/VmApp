# Code - OSS (VS Code): pinned build inputs (read by apps/vscode/build.sh).
#
# Plain KEY=VALUE lines only (no shell expansion, no command substitution, no spaces in values): build.sh parses this file strictly.
#
# What is built, all from the one VS Code tag below: the VS Code Server for the web (reh-web) for linux-arm64 with its built-in extensions
# and its native modules (core/vscode), and the web workbench (ui/static).
# git comes from Debian (core/git).

# VS Code 1.142.0: the tag and the commit it must be (a lightweight tag), the commit's date (the build's "date"), the repository, and
# the SHA-256 of the MIT licence at that commit (LICENSE.txt).
VSCODE_VERSION=1.142.0
VSCODE_TAG=1.142.0
VSCODE_TAG_COMMIT=d956e8a6ac5d904486557eea07e1d6bd62a4d36f
VSCODE_COMMIT_DATE=2026-10-14T11:52:01+02:00
VSCODE_REPO=https://github.com/microsoft/vscode.git
VSCODE_LICENSE_SHA256=9480271317925265e806a9a196aaa33410a962fa9d4d1e248a4a5187bc8c9df9

# The build container: node:24.18.0-bookworm by digest (the Node of VS Code's .nvmrc; Debian bookworm, the glibc of runtime node22, with
# the compilers the native modules need). Created 2026-07-14.
NODE_BUILD_IMAGE=node:24.18.0-bookworm
NODE_BUILD_IMAGE_DIGEST=sha256:5711a0d445a1af54af9589066c646df387d1831a608226f4cd694fc59e745059

# The server's own Node (VS Code's remote/.npmrc "target"; its native modules are built for it): the linux-arm64 tarball's SHA-256, as
# VS Code's build/checksums/nodejs.txt has it (VS Code's gulp task checks the download against that file; build.sh checks both agree).
SERVER_NODE_VERSION=24.21.0
SERVER_NODE_SHA256=724282c3b43aec998aa9527380465b45d229e021b58035f5f4f63095eabfe5d5

# git for the terminal and the Git extension: Debian bookworm's package (the runtime's release), from snapshot.debian.org at this date.
# The container is the node22 runtime's base image (read from runtimes/node22/Dockerfile by build.sh, not repeated here).
APT_SNAPSHOT=20260901T000000Z
APT_GIT=1:2.39.5-0+deb12u3

# Not shipped yet (CONVERSION.md, "Removed"): the built-in Copilot extension and its runtime modules. Upstream builds it apart
# (its own npm install and compile-copilot-extension-build) and it needs GitHub sign-in and network hosts; it comes with the network
# step (docs/design/DEV-APPS.md §11). Every other built-in extension and every other server module of upstream's reh-web ships.
EXCLUDED_EXTENSIONS=copilot
EXCLUDED_MODULES=@github/copilot-sdk,@vscode/copilot-api
