# Local LLM: pinned build inputs for llama-server (read by apps/local-llm/build.sh).
#
# Plain KEY=VALUE lines only (no shell expansion, no command substitution): build.sh parses this file strictly.
#
# The llama.cpp version is NOT here. vmapp/gpu/pins.env is the single source of truth for it, because the VM-side llama-server
# (this app) and the host-side ggml RPC server (the `gpu` host capability) MUST be built from the same llama.cpp commit: the RPC
# protocol is versioned and the server refuses a client of another major version. build.sh reads LLAMA_CPP_REPO, LLAMA_CPP_TAG,
# LLAMA_CPP_COMMIT and RPC_PROTO_VERSION from there, and the build fails if the source at that commit speaks another protocol.

# Build container: debian:bookworm-slim (glibc 2.36, the same distribution release as the node22 runtime's node:22-bookworm-slim,
# so the binary runs there), the multi-arch index digest (the same one tools/mkerofs.Dockerfile uses). apt reads a dated
# snapshot of the Debian archive, so the compiler and cmake are the same on every rebuild.
DEBIAN_IMAGE=debian:bookworm-slim
DEBIAN_DIGEST=sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
DEBIAN_SNAPSHOT=20261005T000000Z
