#
# vmapp guest kernel configuration fragment (Linux 6.18.y, arm64).
#
# Applied on top of `make ARCH=arm64 allnoconfig` (everything off) with
#   scripts/kconfig/merge_config.sh -m ... && make olddefconfig
# by kernel/container/kernel-config.sh. The merged result is then checked by kernel/check-kconfig.sh against
# kconfig-required.txt and kconfig-forbidden.txt; the build fails on any deviation, so a silent `olddefconfig`
# dependency fix-up can never change the shipped feature set.
#
# Derived from d9010-native/guest/distro/kernel/d9010-guest.config (same hardening policy), but trimmed to what a
# vmapp guest uses instead of "defconfig minus things": the guest is one Apple Virtualization.framework VM
# (VZLinuxBootLoader, device tree, GICv3, PSCI, PL031 clock, virtio over PCI) that runs vmapp-init and one app
# core (Node.js, .NET or a static binary) in a chroot. What it has, measured on a booted VM (see SPEC section 4):
#   - /dev/vda (EROFS runtime image) and /dev/vdb (core.cpio), virtio console hvc0, entropy, balloon,
#     vsock (control 1023, bridge 1024) and 9 virtiofs devices (`vmapp`, `vmapp-s0` .. `vmapp-s7`);
#   - no NIC, no USB, no graphics, no input, no modules. Loopback only.
# Network access for apps (a later milestone) will change the networking section on purpose.
#
# Comments must not use the Kconfig "is not set" phrasing (merge_config.sh would parse them as directives).
#

# ---------------------------------------------------------------------------
# 1. Identity and reproducibility
# ---------------------------------------------------------------------------
# Many options below only have a visible prompt when EXPERT is on. EXPERT changes no defaults by itself.
CONFIG_EXPERT=y
CONFIG_LOCALVERSION="-vmapp"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="vmapp"
# Everything needed is built in; nothing can be loaded at run time.
# CONFIG_MODULES is not set
# No debug info: smaller, path-independent, reproducible Image.
CONFIG_DEBUG_INFO_NONE=y
# Diagnostics: /proc/config.gz and symbolised oops traces.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_KALLSYMS=y
CONFIG_PRINTK=y
CONFIG_BUG=y

# ---------------------------------------------------------------------------
# 2. CPU, memory, scheduler (arm64, 4 KiB pages, 48-bit addresses)
# ---------------------------------------------------------------------------
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_ARM64_PA_BITS_48=y
CONFIG_SMP=y
CONFIG_NR_CPUS=32
CONFIG_HOTPLUG_CPU=y
CONFIG_HZ_250=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_ZONE_DMA=y
CONFIG_ZONE_DMA32=y
# Hardware security features of the CPU, switched on at run time when the CPU has them.
CONFIG_ARM64_PAN=y
CONFIG_ARM64_E0PD=y
CONFIG_ARM64_PTR_AUTH=y
CONFIG_ARM64_PTR_AUTH_KERNEL=y
CONFIG_ARM64_BTI=y
CONFIG_ARM64_LSE_ATOMICS=y
CONFIG_ARM64_HW_AFDBM=y
CONFIG_ARM64_TAGGED_ADDR_ABI=y
CONFIG_UNMAP_KERNEL_AT_EL0=y
CONFIG_CPU_MITIGATIONS=y
CONFIG_MITIGATE_SPECTRE_BRANCH_HISTORY=y
CONFIG_RANDOMIZE_BASE=y
# No swap, no memory hot-plug, no NUMA, no contiguous-memory pool (the stock one reserves 32 MB of a small VM).
# CONFIG_SWAP is not set
# CONFIG_NUMA is not set
# CONFIG_CMA is not set
# CONFIG_MEMORY_HOTPLUG is not set
# CONFIG_KSM is not set
# CONFIG_COMPAT is not set
# CONFIG_COMPAT_BRK is not set

# ---------------------------------------------------------------------------
# 3. Platform of Virtualization.framework: device tree, GICv3, timer, PSCI, PL031 clock
# ---------------------------------------------------------------------------
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_GIC_V3_ITS=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_PSCI_FW=y
CONFIG_COMMON_CLK=y
# The guest's wall clock comes from the PL031 RTC of the platform (SPEC section 4).
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
CONFIG_RTC_INTF_SYSFS=y
CONFIG_RTC_INTF_PROC=y
CONFIG_RTC_INTF_DEV=y
CONFIG_RTC_DRV_PL031=y
# Platform (SoC family) selections: none is a Virtualization.framework guest.
# CONFIG_ACPI is not set
# CONFIG_EFI is not set
# CONFIG_PM is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_CRASH_DUMP is not set

# ---------------------------------------------------------------------------
# 4. Boot chain: initramfs, virtio over PCI, console, entropy, balloon
# ---------------------------------------------------------------------------
CONFIG_BLK_DEV_INITRD=y
# The initramfs is an uncompressed cpio (tools/mkcpio); gzip stays, the other decompressors go.
CONFIG_RD_GZIP=y
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
# Console is hvc0 (virtio console), cmdline: console=hvc0.
CONFIG_TTY=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_UNIX98_PTYS=y
# CONFIG_LEGACY_PTYS is not set
# CONFIG_LEGACY_TIOCSTI is not set
# CONFIG_LDISC_AUTOLOAD is not set
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
# The host configures a balloon device; keep the driver so memory can be reclaimed from a VM later.
CONFIG_VIRTIO_BALLOON=y
CONFIG_DEVTMPFS=y

# ---------------------------------------------------------------------------
# 5. Host <-> guest transport: virtio-vsock, virtiofs
# ---------------------------------------------------------------------------
CONFIG_NET=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
# The loopback transport would let guest processes reach guest-local vsock listeners (control port). Must stay off.
# CONFIG_VSOCKETS_LOOPBACK is not set
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
# CONFIG_FUSE_DAX is not set
# CONFIG_FUSE_PASSTHROUGH is not set
# CONFIG_CUSE is not set
# Host-side vhost devices are meaningless inside the guest.
# CONFIG_VHOST_MENU is not set

# ---------------------------------------------------------------------------
# 6. Filesystems: EROFS (lz4) runtime image, tmpfs, devtmpfs, proc, sysfs, devpts
# ---------------------------------------------------------------------------
CONFIG_MISC_FILESYSTEMS=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y
# EROFS images are compressed with lz4hc only (tools/mkruntime) and are always whole block devices.
# CONFIG_EROFS_FS_BACKED_BY_FILE is not set
# CONFIG_EROFS_FS_ZIP_LZMA is not set
# CONFIG_EROFS_FS_ZIP_DEFLATE is not set
# CONFIG_EROFS_FS_ZIP_ZSTD is not set
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_PROC_PAGE_MONITOR=y
CONFIG_SYSFS=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y
# The only filesystems are the ones above: no ext4 (the core arrives as a cpio), no overlay, no loop devices.
# CONFIG_EXT4_FS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_BLK_DEV_LOOP is not set
# CONFIG_NETWORK_FILESYSTEMS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_VFAT_FS is not set
# CONFIG_EXFAT_FS is not set
# CONFIG_AUTOFS_FS is not set
# CONFIG_EFIVAR_FS is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_NET_9P is not set
# CONFIG_9P_FS is not set

# ---------------------------------------------------------------------------
# 7. What the app runtimes (static binaries, Node.js, .NET) need from the kernel
# ---------------------------------------------------------------------------
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_FUTEX_PI=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_FHANDLE=y
CONFIG_RSEQ=y
CONFIG_POSIX_TIMERS=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_SYSVIPC=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
# No container machinery inside the guest: the core runs as uid 1000 in a chroot. Namespaces and cgroups are
# attack surface (unprivileged user namespaces are a frequent local-privilege-escalation route) and unused.
# CONFIG_NAMESPACES is not set
# CONFIG_CGROUPS is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_POSIX_MQUEUE is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_IO_URING is not set
# CONFIG_BINFMT_MISC is not set
# CONFIG_AUDIT is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_DEVMEM is not set
# CONFIG_ELF_CORE is not set

# ---------------------------------------------------------------------------
# 8. Networking: loopback TCP/UDP/AF_UNIX only (the VM has no NIC)
# ---------------------------------------------------------------------------
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_SYN_COOKIES=y
# CONFIG_INET_DIAG is not set
# CONFIG_VSOCKETS_DIAG is not set
# No network devices at all except the always-built loopback device. This removes every NIC driver and the
# veth/tun/bridge-style attack surface.
# CONFIG_NETDEVICES is not set
# CONFIG_NETFILTER is not set
# CONFIG_NET_SCHED is not set
# CONFIG_BRIDGE is not set
# CONFIG_PACKET is not set
# CONFIG_IPV6_SIT is not set
# CONFIG_QRTR is not set
# CONFIG_CAN is not set
# CONFIG_RFKILL is not set
# CONFIG_NFC is not set
# CONFIG_WIRELESS is not set
# CONFIG_BT is not set
# Kernel crypto API exposed to userspace: not needed, nonzero attack surface.
# CONFIG_CRYPTO_USER_API_HASH is not set
# CONFIG_CRYPTO_USER_API_SKCIPHER is not set
# CONFIG_CRYPTO_USER_API_RNG is not set
# CONFIG_CRYPTO_USER_API_AEAD is not set

# ---------------------------------------------------------------------------
# 9. Hardware this VM does not have
# ---------------------------------------------------------------------------
# CONFIG_USB_SUPPORT is not set
# CONFIG_SOUND is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_VT is not set
# CONFIG_INPUT is not set
# CONFIG_HID_SUPPORT is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_MMC is not set
# CONFIG_MTD is not set
# CONFIG_MD is not set
# CONFIG_IOMMU_SUPPORT is not set
# CONFIG_WATCHDOG is not set
# CONFIG_GPIOLIB is not set

# ---------------------------------------------------------------------------
# 10. Hardening
# ---------------------------------------------------------------------------
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_PROC_MEM_FORCE_PTRACE=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
