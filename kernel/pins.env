# vmapp guest kernel: pinned build inputs (single source of truth).
#
# Adapted from d9010-native/guest/distro/pins.env (kernel and reproducibility parts only).
#
# Plain KEY=VALUE lines only (no shell expansion, no command substitution): kernel/build.sh parses this file
# strictly and refuses anything else. Changing a value changes the build, and tools/build.sh then rebuilds the
# kernel (the up-to-date stamp covers this file).

# --- Build container base ---------------------------------------------------------------------
# Multi-arch *index* digest of ubuntu:24.04 (checked with `docker buildx imagetools inspect ubuntu:24.04`).
# kernel/Dockerfile repeats this reference literally in its first FROM line; `kernel/build.sh --check-pins` (and
# every build) fails if the two ever disagree.
UBUNTU_IMAGE=ubuntu:24.04
UBUNTU_DIGEST=sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55

# Ubuntu archive snapshot (https://snapshot.ubuntu.com/ubuntu/<timestamp>) that every apt-get inside the build
# container reads from. It pins the package set (compiler, binutils, ...) so rebuilds are reproducible. Bump
# deliberately to pick up toolchain fixes, then rebuild and re-test.
UBUNTU_SNAPSHOT=20261010T000000Z

# --- Linux kernel -------------------------------------------------------------------------------
KERNEL_VERSION=6.18.56
KERNEL_URL_BASE=https://cdn.kernel.org/pub/linux/kernel/v6.x
# sha256 of linux-6.18.56.tar.xz. It must equal the line in kernel.org's PGP-signed sha256sums.asc; the build
# checks both, plus the signatures (see container/fetch-kernel.sh).
KERNEL_SHA256=4633bbda2ab95eaf2a7af4041236451d6759c72e6946265531af4b3aacefbf89
KERNEL_LOCALVERSION=-vmapp
# Pinned OpenPGP primary-key fingerprints (the trust roots for the source verification). The keys themselves are
# fetched via kernel.org's WKD inside the build container (and cached next to the tarball) and must match these
# fingerprints exactly.
#   autosigner: signs sha256sums.asc ("Kernel.org checksum autosigner")
#   gregkh / torvalds: sign the release tarball (linux-6.18.56.tar.sign)
KERNEL_FPR_AUTOSIGNER=B8868C80BA62A1FFFAF5FDA9632D3A06589DA6B1
KERNEL_FPR_GREGKH=647F28654894E3BD457199BE38DBBDC86092693E
KERNEL_FPR_TORVALDS=ABAF11C65A2970B130ABE3C479BE3E4300411886

# Reproducible kernel build identity (UTS_VERSION / compile.h).
KBUILD_BUILD_USER=vmapp
KBUILD_BUILD_HOST=vmapp-build

# --- Reproducibility ------------------------------------------------------------------------------
# 2026-10-11T00:00:00Z. Used for every timestamp that ends up in the kernel (build time in UTS_VERSION).
SOURCE_DATE_EPOCH=1791676800
