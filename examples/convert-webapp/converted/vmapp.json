{
  "format": 1,
  "id": "dev.vmapp.convert.bookmarks",
  "name": "Bookmarks",
  "version": "1.0.0",
  "publisher": "D9010 VmApp examples",
  "description": "A bookmarks web app (Express + REST) converted to D9010 VmApp: the server runs unchanged inside the VM. See examples/convert-webapp/CONVERSION.md.",
  "runtime": "node22",
  "core": {
    "command": ["node", "main.js"],
    "workdir": "/app",
    "env": { "NODE_ENV": "production" },
    "memoryMiB": 256,
    "cpus": 1
  },
  "ui": { "root": "ui" },
  "permissions": {
    "folders": [],
    "dialogs": false,
    "external": false
  }
}
