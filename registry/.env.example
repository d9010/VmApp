# vmapp registry: the settings compose.yaml passes to the container.
#   cp .env.example .env ; chmod 600 .env ; edit .env
# .env holds credentials. It is git-ignored; never commit it, never paste it into a chat, a ticket or a log.
# Every variable is optional except where a line says "required".

# ---- where the registry listens on the host machine --------------------------------------------------------------------
# compose publishes the container's port 8790 on this address. Leave it on 127.0.0.1 and let a reverse proxy or a
# Cloudflare Tunnel on the same machine reach it.
REGISTRY_BIND=127.0.0.1
REGISTRY_HOST_PORT=8790

# ---- the public address of the registry, as people type it ---------------------------------------------------------------
# Used in verification e-mails ("open this link"), and for the canonical links, Open Graph URLs, structured data and the
# sitemap of the web pages (search engines, link previews). Without it those absolute URLs are left out and /sitemap.xml is a 404.
# With Cloudflare: https://api.<your domain>
REGISTRY_PUBLIC_URL=https://api.example.com

# 1 when a proxy (Cloudflare, nginx, Caddy) sits in front and sets X-Forwarded-For itself: the client address for rate limits
# and download de-duplication is then taken from it. 0 only if clients reach the container directly.
REGISTRY_TRUST_PROXY=1

# ---- storage -------------------------------------------------------------------------------------------------------------
# s3    : an S3-compatible bucket (Cloudflare R2, AWS S3, MinIO). The bucket holds everything: it IS the data and the backup;
#         the container's disk is only a cache.
# local : a directory inside the container's /data volume (no bucket needed; fine for a trial).
REGISTRY_STORAGE=s3

# required for s3. R2: endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com and region auto.
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=vmapp-registry
# an API token scoped to this one bucket, "Object Read & Write" (deploy/HOSTING.md, step 2). Required for s3.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 1 for R2 and MinIO (the bucket name goes in the path), 0 for AWS S3 with no S3_ENDPOINT (default: 1 when S3_ENDPOINT is set)
S3_PATH_STYLE=1

# Downloads redirect (302) to <this>/blobs/sha256/<hh>/<sha256>.vmapp : an R2 custom domain, so that packages are served
# from Cloudflare's network and not through this machine. Empty: the registry streams the packages itself.
# The public address must serve blobs/ ONLY (the event log has publisher e-mail addresses): deploy/HOSTING.md, step 3.
PUBLIC_DOWNLOAD_BASE=https://dl.example.com

# ---- limits and timing ---------------------------------------------------------------------------------------------------
REGISTRY_MAX_PACKAGE_MIB=512
REGISTRY_PUBLISH_PER_HOUR=10
REGISTRY_API_PER_MINUTE=300
# a snapshot every this many events (a new file each time; none is ever overwritten or deleted)
REGISTRY_SNAPSHOT_EVERY=500
# download counters are appended to the log as one event at most this often (minutes)
REGISTRY_COUNTER_FLUSH_MIN=5

# ---- optional ------------------------------------------------------------------------------------------------------------
# A module that exports send({to, subject, text}); the default writes verification e-mails to /data/outbox as .eml files
# (the registry has no SMTP client). Mount the module into the container and give its path here.
#REGISTRY_MAILER=/app/mailer/send.js
