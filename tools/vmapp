#!/usr/bin/env node
'use strict';
// vmapp CLI: new, pack, inspect, verify, install, list, uninstall, grant, grant-host, grant-net, resources, runtime-install, run --headless,
// and the registry commands publish, search, get, withdraw, restore, and versions, use, policy, update.
// Data root: $VMAPP_HOME (default $VMAPP_WORK/vmapp-home; VMAPP_WORK defaults to vmapp/out/work). vmapp-vm / kernel /
// initramfs default to vmapp/out/ (relative to this file) and can be overridden with VMAPP_VM, VMAPP_KERNEL,
// VMAPP_INITRAMFS.

const fs = require('fs');
const path = require('path');
const { pathToFileURL } = require('url');
const { Readable } = require('stream');
const { pipeline } = require('stream/promises');

const ROOT = path.resolve(path.dirname(fs.realpathSync(__filename)), '..');
const hostlib = require(path.join(ROOT, 'hostlib'));
const { Store, AppSession, FakeWindowManager, FakeDialogs, FakeCapabilitiesUi, FakeClipboard, HostCapabilities, Catalog } = hostlib;
const pkg = hostlib.package;

const USAGE = `usage: vmapp <command> [args]

  new <name> [--id com.example.x]       create a new app from a template (default: ./<name>)
        [--template starter] [--dir PATH]
  pack <projectDir> [-o out.vmapp]      build a reproducible package (vmapp.json, <ui.root>/, core/, icon.png)
  inspect <file> [--json]               manifest, package id and sizes
  verify <file>                         full verification; exit 1 with a precise error if invalid
  install <file> [--force]              verify and install (--force allows a downgrade)
  list [--json]                         installed apps
  uninstall <id> [--purge]              remove the app (--purge also removes its data and grants)
  grant <id> <folderName> <path> [--access read|readwrite|writeonly]
                                        save a folder grant non-interactively (default: the requested access)
  grant <id> <folderName> --none        record that the folder was declined
  runtime-install <name> <image>        copy a runtime image to $VMAPP_HOME/runtimes/<name>.img
  run <id> --headless [--script s.mjs]  start the app with a fake window manager
        [--open PATH]... [--save PATH] [--allow-external] [--message-response N]
        [--allow-host] [--duration MS] [--timeout MS]
                                        --allow-host answers every "may <app> use <host capability>?" question with yes
                                        (default: no); the badge calls are logged

host capabilities (SPEC 8.2; the catalog and grants are edited only here and in the loader's own UI):
  tool add <id> --name N --path /abs/exe --arg <regex>... [--optional-arg i]... [--map-path-arg i]...
        [--variadic] [--timeout ms] [--max-output bytes] [--kind tool|shell] [--cwd D] [--description T]
